# Application
APP_ENV=development
APP_PORT=3001
APP_SECRET_KEY=your-secret-key-change-in-production

# Database (PostgreSQL)
DATABASE_URL=postgres://langfuse:langfuse@localhost:5432/langfuse_light?sslmode=disable
POSTGRES_USER=langfuse
POSTGRES_PASSWORD=langfuse
POSTGRES_DB=langfuse_light

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRY=24h

# Storage
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=10485760

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json
