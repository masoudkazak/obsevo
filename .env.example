# =============================================================================
# Langfuse Light — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in values.
# Required variables are marked with [REQUIRED].

# Application
APP_ENV=production                          # development | staging | production
APP_PORT=3001                               # API server port
APP_SECRET_KEY=change-me-in-production      # [REQUIRED] Application secret (min 32 chars)

# Database (PostgreSQL)
DATABASE_URL=postgres://langfuse:langfuse@localhost:5432/langfuse_light?sslmode=disable
POSTGRES_USER=langfuse
POSTGRES_PASSWORD=langfuse                  # Change in production
POSTGRES_DB=langfuse_light
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET=change-me-in-production          # [REQUIRED] JWT signing secret (min 32 chars)
JWT_EXPIRY=24h

# Storage
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=10485760                    # 10MB in bytes

# Logging
LOG_LEVEL=info                              # debug | info | warn | error
LOG_FORMAT=json                             # json | text

# Generate secrets with: openssl rand -base64 48

# Security
# Rate limiting is off when unset or 0. When set, it is the per-minute ceiling
# for a single caller (API key, user, or client IP); the auth and ingestion
# route groups scale their own ceilings from it.
RATE_LIMIT_PER_MINUTE=0

# Comma-separated origins allowed to call the API from a browser. Empty means
# same-origin only, which is correct when the UI is served from this host.
CORS_ALLOWED_ORIGINS=

# Ingestion worker pool size. 0 sizes it from the available CPUs.
WORKER_CONCURRENCY=0

# Postgres connection pool ceiling, shared by HTTP handlers and the worker.
DB_MAX_CONNS=20

# Timeout for outbound calls made by LLM-judge and embedding evaluators.
EVALUATOR_TIMEOUT_SECONDS=30
