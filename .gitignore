# --- Go ---
# Compiled binaries. /server and /obsevo are what `make build` produces.
/server
/obsevo
/bin/
*.exe
*.exe~
*.test
*.out
/vendor/

# Test and profiling output
coverage.out
coverage.html
*.prof
*.pprof

# --- Node / SvelteKit (web/) ---
node_modules/
.svelte-kit/
build/
.vite/
*.tsbuildinfo

# --- SDKs (sdk/) ---
# Build output is regenerated by `npm run build` / `python -m build`.
dist/
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Environment ---
# .env.example is tracked; real secrets are not.
.env
.env.*
!.env.example

# --- Local data ---
# Postgres/Redis volumes and anything a local run writes.
/data/
/tmp/
test-project/
*.db
*.sqlite

# --- Logs ---
*.log

# --- Editors / OS ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
